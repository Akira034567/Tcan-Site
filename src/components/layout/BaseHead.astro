---
import { url } from '../../lib/url.ts';
import { Font } from 'astro:assets';
import { pageMeta, ogSlug } from '../../data/pages.ts';
import { env } from '../../data/company.ts';
import { graph, organization, website, webPage, persons, absolute } from '../../lib/seo.ts';

interface Props {
  path: string;
  /** Extra JSON-LD nodes for this page. */
  schema?: Record<string, unknown>[];
}

const { path, schema = [] } = Astro.props;
const meta = pageMeta(path);
const site = Astro.site;
const canonical = absolute(site, path);
const ogImage = absolute(site, `/og/${ogSlug(path)}.png`);
const noindex = meta.noindex || !env.indexing;
const jsonLd = graph([
  organization(site),
  website(site),
  ...webPage(site, path, meta.title, meta.description, meta.breadcrumb),
  // Founders are referenced by the organization on every page; /sobre/ passes the richer version.
  ...(schema.some((n) => n['@type'] === 'Person') ? [] : persons(site)),
  ...schema,
]).replace(/</g, '\\u003c');
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{meta.title}</title>
<meta name="description" content={meta.description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<Font cssVariable="--font-body" preload />
<Font cssVariable="--font-display" preload />

<noscript><style>.needs-js{display:none!important}</style></noscript>

<meta name="theme-color" content="#141714" />
<meta name="color-scheme" content="light dark" />
<link rel="icon" href={url('/favicon.ico')} sizes="32x32" />
<link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
<link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
<link rel="manifest" href={url('/site.webmanifest')} />
<link rel="sitemap" href={url('/sitemap-index.xml')} />

<meta property="og:type" content="website" />
<meta property="og:locale" content="pt_BR" />
<meta property="og:site_name" content="TCAN Assessoria de Negócios" />
<meta property="og:title" content={meta.title} />
<meta property="og:description" content={meta.description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${meta.ogTitle}: TCAN Assessoria de Negócios`} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={meta.title} />
<meta name="twitter:description" content={meta.description} />
<meta name="twitter:image" content={ogImage} />

<script type="application/ld+json" set:html={jsonLd} />
