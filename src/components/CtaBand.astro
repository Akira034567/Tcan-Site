---
import { url } from '../lib/url.ts';
import Icon from './ui/Icon.astro';
import BrandIcon from './ui/BrandIcon.astro';
import { company } from '../data/company.ts';
import { founderById } from '../data/founders.ts';
import { founderWa } from '../lib/links.ts';

interface Props {
  title?: string;
  text?: string;
  topic?: string;
  founder?: 'tricia' | 'ricardo';
}
const {
  title = company.signature + '.',
  text = 'Conte o desafio da sua empresa. Um sócio responde pessoalmente e, juntos, definimos o melhor caminho.',
  topic,
  founder = company.routing.default,
} = Astro.props;
const person = founderById(founder);
---

<section class="cta on-forest" aria-labelledby="cta-title">
  <div class="container inner">
    <svg class="tick" viewBox="0 0 120 80" aria-hidden="true">
      <path d="M8 44 L40 72 L112 8" pathLength="1" />
    </svg>
    <div class="copy">
      <h2 id="cta-title">{title}</h2>
      <p class="lead">{text}</p>
    </div>
    <div class="actions">
      <a class="btn" href={url('/contato/')}>Fale com um sócio <Icon name="arrow-right" /></a>
      <a class="btn btn--ghost" href={founderWa(person, topic)} target="_blank" rel="noopener" data-location="cta-band">
        <BrandIcon name="whatsapp" size={18} /> WhatsApp com {person.firstName}
      </a>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(50rem 26rem at 90% 120%, rgb(112 191 60 / 0.18), transparent 70%),
      var(--forest-950);
    color: var(--text);
    padding-block: clamp(4rem, 3rem + 4vw, 7rem);
  }
  .inner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: var(--space-6);
    align-items: center;
  }
  .tick {
    width: clamp(4rem, 3rem + 3vw, 6.5rem);
    fill: none;
    stroke: var(--lime-400);
    stroke-width: 11;
    stroke-linecap: square;
    stroke-linejoin: miter;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .tick {
      stroke-dashoffset: 1;
      animation: draw 1.1s var(--ease-out) 0.2s forwards;
      animation-timeline: view();
      animation-range: entry 10% cover 40%;
    }
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  h2 {
    font-size: var(--step-4);
  }
  .lead {
    margin-top: var(--space-3);
    color: #c9d6c5;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: flex-end;
  }
  @media (max-width: 64rem) {
    .inner {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
    .actions {
      justify-content: flex-start;
    }
  }
</style>
