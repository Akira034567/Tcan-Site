---
import Icon from '../ui/Icon.astro';
import { sectors } from '../../data/company.ts';
import type { IconName } from '../../lib/icons.ts';
---

<section class="section section--tight sectors" aria-labelledby="sectors-title">
  <div class="container layout">
    <div>
      <p class="eyebrow">Setores</p>
      <h2 id="sectors-title">Experiência em mercados que exigem execução.</h2>
    </div>
    <ul role="list" class="list">
      {
        sectors.map((s) => (
          <li class="sector">
            <Icon name={s.icon as IconName} size={22} />
            <span>{s.name}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .sectors {
    background: var(--mist);
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
    gap: var(--space-7);
    align-items: center;
  }
  h2 {
    margin-top: var(--space-3);
    font-size: var(--step-3);
  }
  .list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }
  .sector {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 0.85rem 1rem;
    border-radius: var(--radius-md);
    background: var(--white);
    font-weight: 500;
    line-height: 1.3;
  }
  .sector :global(svg) {
    color: var(--forest-800);
    flex: none;
  }
  @media (max-width: 60rem) {
    .layout {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }
  @media (max-width: 30rem) {
    .list {
      grid-template-columns: 1fr;
    }
  }
</style>
