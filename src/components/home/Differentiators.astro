---
import { url } from '../../lib/url.ts';
import Icon from '../ui/Icon.astro';
import { differentiators } from '../../data/content.ts';
---

<section class="section diff" aria-labelledby="diff-title">
  <div class="container layout">
    <div class="section-head">
      <p class="eyebrow">Por que a TCAN</p>
      <h2 id="diff-title">A agilidade de um hub, o compromisso de quem é dono.</h2>
      <p class="lead">
        Você ganha a profundidade de especialistas de cada área sem perder a visão do todo, nem precisar coordenar vários
        fornecedores.
      </p>
      <a class="link-arrow" href={url('/sobre/')}>Conheça a TCAN <Icon name="arrow-right" /></a>
    </div>
    <ul role="list" class="grid">
      {
        differentiators.map((d, i) => (
          <li class="card item" data-reveal style={`--reveal-delay:${(i % 2) * 90}ms`}>
            <span class="icon-badge">
              <Icon name={d.icon} />
            </span>
            <h3>{d.title}</h3>
            <p>{d.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .diff {
    background: var(--white);
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.3fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: start;
  }
  .section-head {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }
  .item {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    background: var(--paper);
    border-color: transparent;
  }
  h3 {
    font-size: var(--step-1);
    margin-top: var(--space-2);
  }
  .item p {
    color: var(--text-muted);
    font-size: 0.975rem;
  }
  @media (max-width: 60rem) {
    .layout {
      grid-template-columns: 1fr;
    }
    .section-head {
      position: static;
    }
  }
  @media (max-width: 36rem) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
