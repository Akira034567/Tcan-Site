---
// Brand glyphs for links to those networks (nominative use). WhatsApp/Instagram paths: Simple Icons (CC0).
import { siWhatsapp, siInstagram } from 'simple-icons';

interface Props {
  name: 'whatsapp' | 'instagram' | 'linkedin';
  size?: number;
  class?: string;
}
const { name, size = 20, class: className } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="currentColor"
  class={className}
  aria-hidden="true"
  focusable="false"
>
  {name === 'whatsapp' && <path d={siWhatsapp.path} />}
  {name === 'instagram' && <path d={siInstagram.path} />}
  {
    name === 'linkedin' && (
      <path d="M20 2H4a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2ZM8.3 19H5.1V9.5h3.2V19ZM6.7 8.1a1.85 1.85 0 1 1 0-3.7 1.85 1.85 0 0 1 0 3.7ZM19 19h-3.2v-4.6c0-1.1 0-2.5-1.5-2.5s-1.75 1.2-1.75 2.4V19H9.4V9.5h3.05v1.3h.05c.45-.8 1.5-1.65 3.05-1.65 3.25 0 3.85 2.1 3.85 4.9V19Z" />
    )
  }
</svg>
