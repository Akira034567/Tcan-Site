---
import { url } from '../lib/url.ts';
/** Native <details> accordion: keyboard and screen-reader friendly with zero JS. */
import Icon from './ui/Icon.astro';

interface Props {
  items: { q: string; a: string }[];
  title?: string;
  eyebrow?: string;
  id?: string;
  tone?: 'light' | 'white';
}
const { items, title = 'Perguntas frequentes', eyebrow = 'FAQ', id = 'faq', tone = 'light' } = Astro.props;
---

<section class:list={['section', 'faq', `faq--${tone}`]} aria-labelledby={`${id}-title`}>
  <div class="container layout">
    <div class="head">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id={`${id}-title`}>{title}</h2>
      <p class="text-muted">Não encontrou sua dúvida? <a href={url('/contato/')}>Fale com um sócio</a>.</p>
    </div>
    <div class="items">
      {
        items.map((item) => (
          <details class="item" name={id}>
            <summary>
              <span>{item.q}</span>
              <Icon name="plus" size={20} class="plus" />
            </summary>
            <div class="answer">
              <p>{item.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq--white {
    background: var(--white);
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: start;
  }
  .head {
    display: grid;
    gap: var(--space-4);
  }
  .items {
    border-top: 1px solid var(--line);
  }
  .item {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding-block: 1.25rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-head);
    font-size: var(--step-1);
    font-weight: 500;
    line-height: 1.35;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary :global(.plus) {
    flex: none;
    color: var(--forest-800);
    transition: rotate var(--dur-2) var(--ease-out);
  }
  .item[open] summary :global(.plus) {
    rotate: 45deg;
  }
  summary:hover {
    color: var(--forest-800);
  }
  .answer {
    padding-bottom: 1.5rem;
    color: var(--text-muted);
  }
  @media (max-width: 60rem) {
    .layout {
      grid-template-columns: 1fr;
    }
  }
</style>
