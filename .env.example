# Public URL of the site (canonical links, sitemap, Open Graph).
SITE_URL=https://www.tcan.com.br
# "true" only for the production deploy; any other value adds noindex and blocks robots.
PUBLIC_INDEXING=false
# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Loaded only after the visitor opts in.
PUBLIC_GA4_ID=
# Optional: endpoint that receives the contact form (POST). Empty = WhatsApp/e-mail fallback.
PUBLIC_CONTACT_ENDPOINT=
